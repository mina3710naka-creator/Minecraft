# ============================================================
#  テキストブロック - フォントデータ初期化
#  美咲フォント(8x8 Japanese pixel font by Num Kadoma, littlelimit.net)
#  由来のドットパターンを storage に展開する
#
#  半角文字(ASCII) : w:4 （3列分のドット + 右1列の余白）
#  全角文字(かな・漢字) : w:8 （7列分のドット + 右1列の余白）
#  高さは共通で8行（0行目が上端、7行目は常に空白の余白行）
#
#  収録内容: 半角英数記号 / ひらがな・カタカナ(小書き・濁点半濁点含む) /
#            常用漢字2136字 全て
# ============================================================

data modify storage textblock:font glyphs set value []

