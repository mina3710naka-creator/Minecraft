# ============================================================
#  10マスジャンプ直後のクールダウン（実行者＝ジャンプ直後のプレイヤー）
#  ウィンドチャージの爆風は一瞬で終わるため、ここでは投げた直後の
#  数tickだけ多重発動（シフト押しっぱなしによる連続ジャンプ）を
#  防ぐためのタグ管理だけを行う
# ============================================================

scoreboard players add @s ob.leapt 1

execute if score @s ob.leapt matches 6.. run tag @s remove ob.leaping
