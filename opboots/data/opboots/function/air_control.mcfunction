# ============================================================
#  空中での自由な移動（実行者＝装備しているプレイヤー）
#  空中にいる間だけ低速落下を毎tickかけ直し続けることで、
#  重力にほとんど縛られず自由に動き回れるようにする
#  （効果時間を短くして、接地した瞬間にすぐ切れるようにしている）
# ============================================================

execute unless entity @s[tag=ob.grounded] run effect give @s minecraft:slow_falling 1 0 true
