	"entrypoints": {
		"client": [
			"com.povreplay.PovReplay"
		]
	},
	"mixins": [
		"povreplay.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": ">=26.2",
		"java": ">=21",
		"fabric-api": "*"
	}
}
